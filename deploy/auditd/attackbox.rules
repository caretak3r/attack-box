# Attack-box auditd rules for honeypot monitoring
# Loaded from /etc/audit/rules.d/90-attackbox.rules

# Delete all existing rules
-D

# Buffer size (increase if events are dropped)
-b 8192

# Failure mode: 1=print to syslog, 2=panic (halt system)
# Use 1 for honeypot (we want to keep running)
-f 1

## Watch critical identity files
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k privilege_escalation
-w /etc/sudoers.d/ -p wa -k privilege_escalation

## Watch Docker and container runtime
-w /usr/bin/docker -p x -k docker_execution
-w /usr/bin/dockerd -p x -k docker_execution
-w /usr/bin/runsc -p x -k container_runtime
-w /var/run/docker.sock -p rwa -k docker_socket
-w /etc/docker/daemon.json -p wa -k docker_config

## Watch attack-box specific files
-w /etc/attackbox/ -p wa -k attackbox_config
-w /usr/local/bin/attackbox -p x -k attackbox_execution
-w /usr/local/bin/attackbox-shipper -p x -k attackbox_execution
-w /var/lib/attackbox-shipper/ -p wa -k attackbox_data

## Watch systemd units
-w /etc/systemd/system/attackbox-shipper.service -p wa -k systemd_unit
-w /etc/systemd/system/attackbox.service -p wa -k systemd_unit

## Watch firewall configuration
-w /etc/nftables.conf -p wa -k firewall
-w /etc/nftables/ -p wa -k firewall

## Syscalls indicating compromise

# Command execution (all processes)
-a always,exit -F arch=b64 -S execve -k exec
-a always,exit -F arch=b32 -S execve -k exec

# Network socket creation (attacker C2)
-a always,exit -F arch=b64 -S socket -S connect -k network_connect
-a always,exit -F arch=b32 -S socket -S connect -k network_connect

# File deletion (covering tracks)
# unlinkat/renameat/renameat2 exist on every arch. Legacy unlink/rename are
# missing on arm64 and make augenrules reject the whole file, so they live in
# attackbox-x86_64.rules, which the deploy script installs on x86_64 only.
-a always,exit -F arch=b64 -S unlinkat -S renameat -S renameat2 -k delete
-a always,exit -F arch=b32 -S unlinkat -S renameat -S renameat2 -k delete

# Privilege escalation attempts
-a always,exit -F arch=b64 -S setuid -S setgid -F a0!=0 -k privilege_change
-a always,exit -F arch=b32 -S setuid -S setgid -F a0!=0 -k privilege_change

# Module loading (rootkits)
-a always,exit -F arch=b64 -S init_module -S finit_module -k module_load
-a always,exit -F arch=b32 -S init_module -S finit_module -k module_load

# Mount operations (escape attempts)
-a always,exit -F arch=b64 -S mount -S umount2 -k mount
-a always,exit -F arch=b32 -S mount -S umount2 -k mount

# Kernel module changes
-w /sbin/insmod -p x -k module_insertion
-w /sbin/rmmod -p x -k module_removal
-w /sbin/modprobe -p x -k module_insertion

# Time changes (can break TLS)
-a always,exit -F arch=b64 -S adjtimex -S settimeofday -S clock_settime -k time_change
-a always,exit -F arch=b32 -S adjtimex -S settimeofday -S clock_settime -k time_change

# Cron and scheduled tasks
-w /etc/cron.allow -p wa -k cron
-w /etc/cron.deny -p wa -k cron
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /etc/crontab -p wa -k cron
-w /var/spool/cron/ -p wa -k cron

# SSH configuration
-w /etc/ssh/sshd_config -p wa -k ssh_config
-w /etc/ssh/sshd_config.d/ -p wa -k ssh_config

# User session tracking
-w /var/log/wtmp -p wa -k session
-w /var/log/btmp -p wa -k session
-w /var/run/utmp -p wa -k session

## Make configuration immutable (requires reboot to change)
## Uncomment after testing
# -e 2
