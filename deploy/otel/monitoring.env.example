# Root-owned 0600 at /etc/attackbox/monitoring.env. No credentials here.
# Host ID and campaign ID: [a-z0-9][a-z0-9_.-]{0,62}, same as log sensor/deployment IDs.
# Other values: bounded ASCII letters, digits, periods, underscores and hyphens.
ATTACKBOX_HOST_ID=REPLACE_HOST_ID
ATTACKBOX_HOST_NAME=REPLACE_HOST_NAME
ATTACKBOX_CAMPAIGN_ID=REPLACE_CAMPAIGN_ID
ATTACKBOX_BAIT_INSTANCE_ID=REPLACE_HOST_ID-bait
ATTACKBOX_SHIPPER_INSTANCE_ID=REPLACE_HOST_ID-shipper
ATTACKBOX_MONITOR_INSTANCE_ID=REPLACE_HOST_ID-monitor
ATTACKBOX_OTEL_INSTANCE_ID=REPLACE_HOST_ID-otel
ATTACKBOX_BAIT_CONTAINER_ID=
ATTACKBOX_RELEASE_VERSION=REPLACE_RELEASE_VERSION
