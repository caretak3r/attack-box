<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.attackbox.evidence-pull</string>
	<key>Program</key>
	<string>/Users/YOURUSER/attack-box/scripts/evidence-pull.sh</string>
	<key>WorkingDirectory</key>
	<string>/Users/YOURUSER/attack-box</string>
	<key>StandardOutPath</key>
	<string>/Users/YOURUSER/.local/state/attackbox/evidence-pull.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOURUSER/.local/state/attackbox/evidence-pull.err</string>
	<key>StartInterval</key>
	<integer>900</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>KeepAlive</key>
	<false/>
</dict>
</plist>
