[Unit]
Description=Attack-box egress event adapter
Documentation=https://github.com/example/attack-box
After=systemd-journald.service attackbox-shipper.service
Requires=attackbox-shipper.service

[Service]
Type=simple
User=root
Group=root

# Commit source positions only after durable shipper receipts.
ExecStart=/usr/local/bin/attackbox-hostreader -source journal -state-dir /var/lib/attackbox-egress-reader -socket /run/attackbox/egress.sock
StateDirectory=attackbox-egress-reader
StateDirectoryMode=0700

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/
ReadWritePaths=/var/lib/attackbox-egress-reader
RestrictAddressFamilies=AF_UNIX

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=attackbox-egress-adapter

# Restart policy
Restart=on-failure
RestartSec=5s

# Resource limits
MemoryMax=128M
TasksMax=50

[Install]
WantedBy=multi-user.target
