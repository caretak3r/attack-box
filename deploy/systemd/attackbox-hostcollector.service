[Unit]
Description=AttackBox local inventory and readiness metrics
After=network.target attackbox-hostcollector-snapshot.service
Wants=attackbox-hostcollector-snapshot.timer

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/local/bin/attackbox-hostcollector
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:9465
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/etc/attackbox/shipper.env
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
MemoryMax=64M
TasksMax=32
CPUQuota=10%
TimeoutStopSec=10s
UMask=0077

[Install]
WantedBy=multi-user.target
