[Unit]
Description=Attack-box telemetry shipper
Documentation=https://github.com/example/attack-box
After=network-online.target nftables.service
Wants=network-online.target
Before=docker.service

[Service]
Type=simple
User=abx-ship
Group=abx-ship
SupplementaryGroups=abx-bait

# Environment from root-owned file (must exist before startup)
EnvironmentFile=/etc/attackbox/shipper.env

# Binary (must exist)
ExecStart=/usr/local/bin/attackbox-shipper

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/
ReadWritePaths=/run/attackbox /var/lib/attackbox-shipper

# State directory (mode 0700, owned by abx-ship)
StateDirectory=attackbox-shipper
StateDirectoryMode=0700

# Runtime directory (mode 0710, owned by abx-ship:abx-bait)
RuntimeDirectory=attackbox
RuntimeDirectoryMode=0710

# Logging to journal with bounded size
StandardOutput=journal
StandardError=journal
SyslogIdentifier=attackbox-shipper

# Restart policy
Restart=on-failure
RestartSec=5s

# Resource limits
MemoryMax=256M
TasksMax=100

# Capabilities (none needed)
CapabilityBoundingSet=
AmbientCapabilities=

# Namespace isolation
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectClock=yes

# Network access for New Relic egress
PrivateNetwork=no

# System calls
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# File system
ProtectProc=invisible
ProcSubset=pid
PrivateMounts=yes

# Service startup
TimeoutStartSec=10s
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
