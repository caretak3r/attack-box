[Unit]
Description=Attack-box telemetry shipper
Documentation=https://github.com/example/attack-box
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
User=abx-ship
Group=abx-ship

# Environment from root-owned file
EnvironmentFile=/etc/attackbox/shipper.env

# Binary
ExecStart=/usr/local/bin/attackbox-shipper

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/
ReadWritePaths=/run/attackbox /var/lib/attackbox-shipper /var/log/attackbox-shipper

# State directory (mode 0700, owned by abx-ship)
StateDirectory=attackbox-shipper
StateDirectoryMode=0700

# Runtime directory
RuntimeDirectory=attackbox
RuntimeDirectoryMode=0770

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=attackbox-shipper

# Restart policy
Restart=on-failure
RestartSec=5s

# Resource limits
MemoryMax=256M
TasksMax=100

# Capabilities (none needed)
CapabilityBoundingSet=
AmbientCapabilities=

# Namespace isolation
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectClock=yes

# Network
# Note: shipper needs network for New Relic egress
PrivateNetwork=no

# System calls
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# File system
ProtectProc=invisible
ProcSubset=pid
PrivateMounts=yes

# Service startup
TimeoutStartSec=10s
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
