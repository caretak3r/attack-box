[Unit]
Description=AttackBox fixed privileged inventory snapshot
After=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/attackbox-hostcollector -snapshot
RuntimeDirectory=attackbox-monitoring
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
TimeoutStartSec=12s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/attackbox-monitoring
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=-/etc/attackbox/shipper.env
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
MemoryMax=96M
TasksMax=64
CPUQuota=20%
