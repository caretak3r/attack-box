[Unit]
Description=AttackBox Public OpenTelemetry Collector
After=network-online.target nftables.service
Requires=nftables.service
PartOf=nftables.service
StopWhenUnneeded=yes
Wants=network-online.target

[Service]
Type=simple
User=abx-public-otel
Group=abx-public-otel
EnvironmentFile=/etc/attackbox-public-otel/environment
LoadCredential=newrelic_license_key:/etc/attackbox-public-otel/license.key
LoadCredential=config.yaml:/etc/attackbox-public-otel/config.yaml
ExecStartPre=+/usr/local/libexec/attackbox-public-otel-socket prepare
ExecStart=/usr/local/libexec/attackbox-public-otel --config=%d/config.yaml
ExecStartPost=/usr/local/libexec/attackbox-public-otel-socket ready
ExecStopPost=+/usr/local/libexec/attackbox-public-otel-socket cleanup
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=15s
MemoryMax=256M
TasksMax=100
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# The privileged prepare helper creates the setgid socket directory before ExecStart.
ReadWritePaths=-/run/attackbox-public-otel
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
StandardOutput=null
StandardError=null
