[Unit]
Description=Attack-box Falco runtime event adapter
Documentation=https://github.com/example/attack-box
After=falco-modern-bpf.service attackbox-shipper.service
Requires=falco-modern-bpf.service attackbox-shipper.service

[Service]
Type=simple
User=root
Group=root

# Commit source positions only after durable shipper receipts.
ExecStart=/usr/local/bin/attackbox-hostreader -source falco -state-dir /var/lib/attackbox-falco-reader -socket /run/attackbox/runtime.sock -file /var/log/falco-events.jsonl
StateDirectory=attackbox-falco-reader
StateDirectoryMode=0700

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/
ReadWritePaths=/var/lib/attackbox-falco-reader
RestrictAddressFamilies=AF_UNIX

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=attackbox-falco-adapter

# Restart policy
Restart=on-failure
RestartSec=5s

# Resource limits
MemoryMax=128M
TasksMax=50

[Install]
WantedBy=multi-user.target
