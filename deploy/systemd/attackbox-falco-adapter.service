[Unit]
Description=Attack-box Falco runtime event adapter
Documentation=https://github.com/example/attack-box
After=falco-modern-bpf.service attackbox-shipper.service
Requires=falco-modern-bpf.service attackbox-shipper.service

[Service]
Type=simple
User=root
Group=root

# Own socket on the shipper: the spool.sock default only admits the bait uid
Environment=ATTACKBOX_SPOOL_SOCKET=/run/attackbox/runtime.sock

# Follow Falco JSONL output and pipe to shipper
ExecStart=/bin/bash -c 'exec tail -n0 -F /var/log/falco-events.jsonl | /usr/local/bin/attackbox-shipper -stdin-stream runtime'

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/
ReadWritePaths=/var/log

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=attackbox-falco-adapter

# Restart policy
Restart=on-failure
RestartSec=5s

# Resource limits
MemoryMax=64M
TasksMax=50

[Install]
WantedBy=multi-user.target
