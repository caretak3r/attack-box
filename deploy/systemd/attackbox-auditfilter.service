[Unit]
Description=AttackBox bounded audit event compaction
After=auditd.service
Requires=auditd.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/attackbox-auditfilter
StateDirectory=attackbox-auditfilter
StateDirectoryMode=0700
LogsDirectory=attackbox-audit
LogsDirectoryMode=0700
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/attackbox-auditfilter /var/log/attackbox-audit
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
MemoryMax=96M
TasksMax=16
CPUQuota=20%
UMask=0077

[Install]
WantedBy=multi-user.target
