# Strict Docker build context: only Go source and module files

# Deny everything by default
*

# Allow only required files
!go.mod
!go.sum
!cmd/
!internal/

# Explicitly block sensitive paths even if they match above
.git/
.gnhf/
secrets/
*.key
*.crt
*.pem
context-log*.md
local://*
*.log
research/
scripts/
*.md
!cmd/**/*.go
!internal/**/*.go

# Bootstrap generates this tree from the committed Go module files.
!vendor/
!vendor/**
